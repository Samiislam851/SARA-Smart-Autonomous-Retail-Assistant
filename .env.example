# Copy to .env and adjust. Read by docker-compose.yml.

# stub | llm | cached | fallback — read by agent/decide/index.js. "fallback"
# runs the deterministic fallback decider only (no LLM call) — useful with
# no model key/CLI available.
AGENT_MODE=stub

# off disables the deterministic fallback decider that agent/decide/llm.js
# falls back to when the real LLM backend times out, errors, or returns a
# bad shape (agent/decide/fallback.js). Default on (any value other than
# "off" keeps it enabled).
AGENT_FALLBACK=

# Host path to your codex CLI home (contains auth.json + config.toml),
# mounted read-write into the agent container so token refreshes persist.
CODEX_HOME=~/.codex

# Host path to your claude CLI home (contains .credentials.json), mounted
# read-write into the agent container for LLM_BACKEND=claude. Same uid 1000
# note as CODEX_HOME applies — see docs/OPS.md.
CLAUDE_HOME=~/.claude

# Build-time only (inlined into the demo-store bundle, see demo-store/Dockerfile). Point
# these at wherever the agent is publicly reachable, e.g. the
# tunnel-agent URL printed by scripts/tunnel-up.sh.
PUBLIC_HTTP=http://localhost:4000
PUBLIC_WS=ws://localhost:4000

# Read by agent/decide/llm.js (AGENT_MODE=llm).
LLM_MODEL=
# claude backend: measured in Docker 2026-09-11 with the real prompt — haiku ~22 s/decision (often noop),
# sonnet ~8 s/decision (correct highlight). Use LLM_MODEL=sonnet for live demos.
# codex | claude | openai | anthropic | gemini
LLM_BACKEND=

# claude backend only. Path to the claude CLI binary. Default: claude.
CLAUDE_BIN=

# openai backend only. Bearer key sent to OPENAI_BASE_URL. Works unmodified
# against OpenAI itself, OpenRouter, or a local Ollama server.
OPENAI_API_KEY=
# openai backend only. Defaults to https://api.openai.com/v1; point at
# OpenRouter or a local Ollama server (e.g. http://localhost:11434/v1).
OPENAI_BASE_URL=

# anthropic backend only. Resolved by @anthropic-ai/sdk (ANTHROPIC_API_KEY
# env or an `ant auth login` profile). Never hardcode a key here.
ANTHROPIC_API_KEY=

# gemini backend only. Resolved by @google/genai (GEMINI_API_KEY or
# GOOGLE_API_KEY — SDK prefers GOOGLE_API_KEY if both are set).
GEMINI_API_KEY=

# Per-call hard timeout in ms for any llm backend. Default 20000 (30000 for
# the claude backend specifically).
LLM_TIMEOUT_MS=
# openai backend only. schema | object. Unset auto-detects once at startup.
LLM_JSON_MODE=
# 0 disables the fingerprint cache (forces every llm call to miss). Default enabled.
LLM_CACHE=
# Max concurrent codex/openai calls process-wide. Default 2.
LLM_MAX_CONCURRENT=
# 1 to record the decider's pre-policy proposal per event to sessions/recorded/.
AGENT_RECORD=
# 1 to enable POST /metrics/reset. Unset/anything else → 404.
AGENT_METRICS_RESET=

# Merchant policy knobs — agent/policy.js's last-line-of-defense guards.
# All optional; invalid/out-of-range values fall back to the default with a
# console.warn. See agent/POLICY.md for the full reference + recipes.
# Min ms between non-noop actions per session. Tighten-only: min 30000
# (fixed contract floor), max 600000. Below-floor values fall back to 30000.
# Default 30000.
AGENT_COOLDOWN_MS=
# Max non-noop actions delivered per session. 0 = zero nudges (agent
# silent); -1 = unlimited; N>0 = that many. Default 3.
AGENT_MAX_NUDGES_PER_SESSION=
# Frequency & fatigue (docs/BEHAVIOR-MATRIX.md, agent/POLICY.md "Frequency
# & fatigue"). Max non-noop actions per page_view; -1 = unlimited.
# Sensitivity-aware default: 1 ("normal"), 2 ("demo").
AGENT_MAX_CARDS_PER_PAGEVIEW=
# Same card TEMPLATE not re-shown after the shopper dismissed it, for the
# rest of the session. true|false. Default true.
AGENT_SUPPRESS_AFTER_DISMISS=
# Widget-side: ms a shown card stays on screen before auto-collapsing into
# the suggestions tray (paused while hovered/focused). Not a policy guard —
# sent to the widget on the action's wire message. Default 12000.
AGENT_CARD_TTL_MS=
# Comma list of allowed actions (subset of highlight,scroll_to,message,
# spotlight,noop). Default: all. noop is always allowed. Fail-closed: if
# every entry is invalid, falls back to noop-only (not the permissive
# default).
AGENT_ALLOWED_ACTIONS=
# Comma list of target ids the agent may never act on. Default: none.
AGENT_DENY_TARGETS=
# Max message length; may only lower the contract's 140-char cap. Default 140.
AGENT_MAX_MESSAGE_CHARS=
# Minimum trace.confidence (0-1) required for a non-noop action. Default 0.
AGENT_MIN_CONFIDENCE=
# gate.js/tick.js knob — how readily the pre-model layer asks the model for
# a decision. "normal" (default) is tuned for a real shopper session;
# "demo" multiplies every gate.js dwell/window threshold by 0.6 and shrinks
# the tick.js dwell-bucket boundaries by the same factor, so a live demo
# doesn't require sitting through the full normal thresholds. Invalid value
# falls back to "normal". See agent/POLICY.md.
AGENT_SENSITIVITY=
# gate.js consult floor — an active shopper (>=1 non-heartbeat event in the
# last 20s) who hasn't tripped any friction signal for this many ms still
# gets a periodic model call (reason "floor"), so a normal quiet browsing
# session isn't 0 model calls forever. Sensitivity-aware default: 30000
# ("normal"), 20000 ("demo"). Invalid/out-of-range (min 1000, max 600000)
# falls back to the sensitivity default. See agent/POLICY.md.
AGENT_CONSULT_FLOOR_MS=
# gate.js hard cost cap — max model calls per session in any rolling 60s
# window, across EVERY trigger reason (friction signals, floor, page
# moments) — never just the floor. Invalid (non-integer or < 1) falls back
# to the default. Default 6. See agent/POLICY.md.
AGENT_MAX_MODEL_CALLS_PER_MIN=

# Debug: enable session recording for /sessions research pages.
AGENT_DEBUG=

# Optional durable persistence (agent/persist.js, docs/OPS.md
# "Persistence"): a Mongo connection string, e.g.
# mongodb://127.0.0.1:27017/sara_agent. Unset (default) -> no-op, zero
# behavior change. Set -> sessions/events/decisions/outcomes survive a
# restart and are queryable; /sessions research pages fall back to this DB
# when the in-memory/live-record copy is gone.
AGENT_DB_URI=
