MONGODB_URI=mongodb://localhost:27017/nextcart

# HMAC secret for signing the nextcart_session cookie (src/lib/session/cookie.ts).
# Dev-only default below — set a real secret via the deployment platform in production.
SESSION_SECRET=dev-insecure-session-secret-change-me-in-production

# agent-storefront widget (agent-storefront/server, :4000 in dev). See
# agent-storefront/docs/NEXTCART.md.
NEXT_PUBLIC_AGENT_URL=http://localhost:4000
